{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "KPMG Pulse Mandate API",
    "description": "Mandate API of the KPMG Pulse Platform"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "tags": null,
  "security": [
    {
      "JWT": []
    }
  ],
  "paths": {
    "/bank/checkBbanValidity": {
      "get": {
        "tags": [
          "Bank"
        ],
        "summary": "Validate a French BBAN",
        "description": "Validate a French BBAN",
        "operationId": "ValidateBban",
        "parameters": [
          {
            "in": "query",
            "name": "bban",
            "description": "Concatenated fields of the BBAN, including Check Digits.",
            "schema": {
              "type": "string"
            },
            "required": true,
            "example": "10000000011234567890189"
          }
        ],
        "responses": {
          "200": {
            "description": "Results of the BBAN validation.",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Result of the BBAN validation.",
                  "type": "object",
                  "required": [
                    "valid"
                  ],
                  "properties": {
                    "valid": {
                      "description": "Indicating whether if the BBAN is valid.",
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bank/{bankCode}": {
      "get": {
        "tags": [
          "Bank"
        ],
        "summary": "Get reference data for a bank",
        "description": "Get reference data for a bank",
        "operationId": "GetBankDetails",
        "parameters": [
          {
            "in": "path",
            "name": "bankCode",
            "description": "The bank code (first parameter of the French BBAN) to be queried",
            "schema": {
              "type": "string"
            },
            "required": true,
            "example": "12345"
          }
        ],
        "responses": {
          "200": {
            "description": "Reference data for the bank.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BankDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Bank not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "BankNotFound": {
                    "value": {
                      "errorType": "BankNotFound",
                      "logReference": "12345",
                      "message": "The 'xxxx' bank code has not been found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/company/{erpId}": {
      "get": {
        "tags": [
          "Company"
        ],
        "summary": "Get reference data for the company",
        "description": "Get reference data for the company",
        "operationId": "GetCompanyByErpNumber",
        "parameters": [
          {
            "in": "path",
            "name": "erpId",
            "description": "The account number of the company to be queried",
            "schema": {
              "type": "string"
            },
            "required": true,
            "example": "12345"
          }
        ],
        "responses": {
          "200": {
            "description": "Reference data for the Company.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "CompanyForbidden": {
                    "value": {
                      "errorType": "CompanyForbidden",
                      "logReference": "12345",
                      "message": "The 'erpNumber' must be part of your portfolio and have active engagement"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Company not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "CompanyNotFound": {
                    "value": {
                      "errorType": "CompanyNotFound",
                      "logReference": "12345",
                      "message": "The 'erpNumber' account number has not been found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/mandate/collection": {
      "get": {
        "tags": [
          "Mandate"
        ],
        "summary": "Get reference data for mandate",
        "description": "Get reference data for mandate",
        "operationId": "GetCollectionsAsync",
        "parameters": [
          {
            "in": "query",
            "name": "skip",
            "description": "skip",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "example": 0
          },
          {
            "in": "query",
            "name": "limit",
            "description": "limit",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "example": 20
          },
          {
            "in": "query",
            "name": "searchTerm",
            "description": "searchTerm",
            "schema": {
              "type": "string"
            },
            "required": false,
            "example": "1000265308"
          },
          {
            "in": "query",
            "name": "creationDateStart",
            "description": "CreationDateStart",
            "schema": {
              "type": "string"
            },
            "required": false,
            "example": "2023-09-01"
          },
          {
            "in": "query",
            "name": "creationDateEnd",
            "description": "CreationDateEnd",
            "schema": {
              "type": "string"
            },
            "required": false,
            "example": "2023-09-01"
          },
          {
            "in": "query",
            "name": "modificationDateStart",
            "description": "modificationDateStart",
            "schema": {
              "type": "string"
            },
            "required": false,
            "example": "2023-09-01"
          },
          {
            "in": "query",
            "name": "modificationDateEnd",
            "description": "modificationDateEnd",
            "schema": {
              "type": "string"
            },
            "required": false,
            "example": "2023-09-01"
          },
          {
            "in": "query",
            "name": "statusCodes",
            "description": "StatusCodes",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "required": false
          },
          {
            "in": "query",
            "name": "sortCriteria",
            "description": "sortCriteria",
            "schema": {
              "type": "string",
              "enum": [
                "ErpId",
                "Name",
                "AccountNumber",
                "BankName",
                "CreationDate",
                "ModificationDate",
                "Status"
              ]
            },
            "required": false,
            "example": null
          },
          {
            "in": "query",
            "name": "sortOrder",
            "description": "sortOrder",
            "schema": {
              "type": "string",
              "enum": [
                "Ascending",
                "Descending"
              ]
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Reference data for mandate.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MandateCollection"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Account not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "AccountNotFound": {
                    "value": {
                      "errorType": "AccountNotFound",
                      "logReference": "12345",
                      "message": "The 'erpNumber' account number has not been found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Gets the status of the API.",
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "The status of the API.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "description": "Global status of the API",
                      "$ref": "#/components/schemas/HealthStatus",
                      "example": "Healthy"
                    },
                    "sqlDatabase": {
                      "description": "Information of the SQL database",
                      "type": "object",
                      "properties": {
                        "status": {
                          "description": "Status of the SQL database",
                          "$ref": "#/components/schemas/HealthStatus",
                          "example": "Healthy"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "JWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Bearer token is missing or invalid"
      }
    },
    "schemas": {
      "BankDetail": {
        "description": "Reference data for a bank.",
        "type": "object",
        "properties": {
          "code": {
            "description": "Bank code, as defined in a French BBAN",
            "type": "string",
            "example": "12345"
          },
          "name": {
            "description": "Bank name",
            "type": "string",
            "example": "Banque postale"
          },
          "jeDeclare": {
            "$ref": "#/components/schemas/BankJdcDetail"
          }
        }
      },
      "BankJdcDetail": {
        "description": "Data specific to JeDeclare.com.",
        "type": "object",
        "properties": {
          "isPartner": {
            "description": "Defines if the bank is a JDC partner",
            "type": "boolean",
            "example": true
          },
          "isScrapable": {
            "description": "Defines if JDC can use scrapping with the bank",
            "type": "boolean",
            "example": true
          }
        }
      },
      "Address": {
        "description": "Data specific to the address.",
        "type": "object",
        "properties": {
          "street": {
            "description": "Defines the signatory street address.",
            "type": "string",
            "example": "RUE DU COMMERCE"
          },
          "addressComplement": {
            "description": "Defines the signatory address complements.",
            "type": "string",
            "example": null
          },
          "zipCode": {
            "description": "Defines the signatory address zip code.",
            "type": "string",
            "example": "59590"
          },
          "city": {
            "description": "Defines the signatory address city.",
            "type": "string",
            "example": "RAISMES"
          },
          "country": {
            "description": "Defines the signatory address country.",
            "type": "string",
            "example": "FRANCE"
          }
        }
      },
      "Signatory": {
        "description": "Data specific to the signatory.",
        "type": "object",
        "properties": {
          "title": {
            "description": "Defines the signatory sex.",
            "type": "string",
            "example": "M"
          },
          "firstName": {
            "description": "Defines the signatory first name.",
            "type": "string",
            "example": "maroo"
          },
          "lastName": {
            "description": "Defines the signatory Last name.",
            "type": "string",
            "example": "elleuch"
          },
          "email": {
            "description": "Defines the signatory email.",
            "type": "string",
            "example": "elleuch@email.com"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "Company": {
        "description": "Data specific to the account.",
        "type": "object",
        "properties": {
          "id": {
            "description": "Defines the account identifier.",
            "type": "string",
            "format": "uuid",
            "example": "e4ec92f2-a375-4574-b6de-235a9fe13028"
          },
          "name": {
            "description": "Defines the account leagal name.",
            "type": "string",
            "example": "JEAN LÉVAGE"
          },
          "siretNumber": {
            "description": "Defines the siret number of the account.",
            "type": "string",
            "example": "40902900600031"
          },
          "erpId": {
            "description": "Defines the account number of the account.",
            "type": "string",
            "example": "1000265308"
          },
          "signatory": {
            "$ref": "#/components/schemas/Signatory"
          }
        }
      },
      "MandateCollection": {
        "description": "Data specific to the mandate.",
        "type": "object",
        "properties": {
          "id": {
            "description": "Defines the mandate identifier.",
            "type": "string",
            "format": "uuid",
            "example": "e4ec92f2-a375-4574-b6de-235a9fe13028"
          },
          "erpId": {
            "description": "Defines the account number of the company.",
            "type": "string",
            "example": "1000265308"
          },
          "companyName": {
            "description": "Defines the account legal name.",
            "type": "string",
            "example": "JEAN LÉVAGE"
          },
          "accountNumber": {
            "description": "Defines the bank account number of the mandate IBAN.",
            "type": "string",
            "example": "66842913356"
          },
          "bankName": {
            "description": "Defines the name of the bank attached to the mandate.",
            "type": "string",
            "example": "SOGE"
          },
          "creationDate": {
            "description": "Defines the creation date of the mandate.",
            "type": "string",
            "example": "2023-08-14T13:12:31.926Z"
          },
          "ModificationDate": {
            "description": "Defines the last update date of the mandate.",
            "type": "string",
            "example": "2023-08-14T13:12:31.926Z"
          },
          "statusCode": {
            "description": "Defines the jdc side status code of the collection mandate.",
            "type": "string",
            "example": "99"
          },
          "statusName": {
            "description": "Defines the status name of the mandate.",
            "type": "string",
            "example": "Actif"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "Represents an error when calling the Mandate API.",
        "required": [
          "errorType",
          "logReference",
          "message"
        ],
        "properties": {
          "errorType": {
            "description": "Identifier of the error.",
            "type": "string",
            "example": "InvalidCompanyCode"
          },
          "logReference": {
            "description": "Reference of the detailed log in Azure Insight.",
            "type": "string",
            "example": "12345abcd"
          },
          "message": {
            "description": "Error message. Can be displayed on client side.",
            "type": "string",
            "example": "The specified company identifier is incorrect."
          }
        }
      },
      "HealthStatus": {
        "description": "Represents the status of the health of the API.",
        "type": "string",
        "enum": [
          "Healthy",
          "Unhealthy"
        ]
      }
    }
  }
}